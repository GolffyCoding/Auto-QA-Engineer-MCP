# Copy this file to .env and fill in what you need, or export these
# directly in the environment that runs `qa-mcp-serve` (e.g. in your MCP
# client's config, or your shell profile). Nothing here is required to
# start qa-mcp-serve - every var below has a safe default if unset.
#
# qa-mcp-serve does NOT load .env automatically (no python-dotenv
# dependency) - either `export $(cat .env | xargs)` before starting it,
# use a process manager that loads .env for you, or set these directly in
# your MCP client's server config (see README.md#connecting-an-llm).


# --- Persistence -------------------------------------------------------

# Where test runs, defects, failure evidence, and patch proposals persist
# to disk. Point your whole team at the same path (e.g. a shared network
# drive, or a path synced some other way) to share state across everyone's
# qa-mcp-serve sessions. Default: ./qa-mcp-state.json
# QA_MCP_STATE_DB=./qa-mcp-state.json


# --- Approval gate -------------------------------------------------------

# Must be "1" for fix_loop.apply_patch to actually write to disk. Left
# unset (the default), fix_loop.apply_patch always refuses to touch the
# filesystem regardless of what the agent passes as read_only - an LLM
# agent cannot set this itself from inside a tool call. Set this only for
# the moment a human is actually approving a patch, then unset it again -
# do not leave it set permanently in the environment qa-mcp-serve runs in.
# QA_MCP_ALLOW_AUTO_APPLY=1


# --- Company/project customization ---------------------------------------

# Path to a plain text/markdown file of your team's QA conventions - it
# gets appended to what the LLM is told when it connects (see
# qa_mcp/server.py's create_server()). Use this for conventions you know
# up front and that don't change often (e.g. "always use Playwright, not
# Selenium", "the staging URL is https://staging.example.internal").
#
# For conventions that accumulate over time as you use the tool (a
# project-specific failure pattern you keep re-diagnosing, a QA decision
# worth remembering), use the knowledge.add_rule / knowledge.add_failure_pattern
# / knowledge.add_decision MCP tools instead - those persist via
# QA_MCP_STATE_DB above and don't need a file or a restart.
# QA_MCP_INSTRUCTIONS_FILE=./company-qa-conventions.md


# --- k6 load testing -----------------------------------------------------

# Path to the k6 binary, if it's not already on PATH.
# QA_MCP_K6_BIN=/usr/local/bin/k6


# --- CI/CD triggers (ci.run / ci.get_status) ------------------------------

# GitHub Actions - needs a token with `actions:write` on the target repo.
# GITHUB_TOKEN=

# GitLab CI - trigger token (for ci.run) and a separate API token (for
# ci.get_status); they're different token types in GitLab.
# GITLAB_TRIGGER_TOKEN=
# GITLAB_API_TOKEN=
